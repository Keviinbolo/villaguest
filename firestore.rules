rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // FIX Vuln 1: El fallback "sin documento = admin" fue eliminado.
    // Todo usuario DEBE tener un documento /users/{uid} con role:'admin'
    // creado manualmente desde Firebase Console para tener acceso.
    // Un usuario autenticado sin documento no tiene ningún privilegio.
    function isAdmin() {
      return isSignedIn() &&
        userDocExists() &&
        userDoc().data.role == 'admin';
    }

    function isStaff() {
      return isSignedIn() &&
        userDocExists() &&
        userDoc().data.role == 'staff';
    }

    // FIX Vuln 2: Aislamiento por villa.
    // Devuelve el villaId asignado al usuario autenticado.
    function myVilla() {
      return userDoc().data.villa;
    }

    // Verifica que el documento existente pertenece a la villa del usuario.
    function resourceBelongsToMyVilla() {
      return resource.data.villaId == myVilla();
    }

    // Verifica que el documento que se va a escribir pertenece a la villa del usuario.
    function requestBelongsToMyVilla() {
      return request.resource.data.villaId == myVilla();
    }

    // ─── Reservas ────────────────────────────────────────────────────────
    // Solo admin. Lectura y escritura restringidas a la propia villa.
    match /bookings/{bookingId} {
      allow read:   if isAdmin() && resourceBelongsToMyVilla();
      allow create: if isAdmin() && requestBelongsToMyVilla();
      allow update: if isAdmin() && resourceBelongsToMyVilla() && requestBelongsToMyVilla();
      allow delete: if isAdmin() && resourceBelongsToMyVilla();
    }

    // ─── Checklists de limpieza ───────────────────────────────────────────
    // Admin y staff pueden leer y actualizar tareas.
    // Solo admin puede crear y borrar (se gestiona desde el detalle de reserva).
    match /cleaning_checklists/{checklistId} {
      allow read:   if (isAdmin() || isStaff()) && resourceBelongsToMyVilla();
      allow update: if (isAdmin() || isStaff()) && resourceBelongsToMyVilla();
      allow create: if isAdmin() && requestBelongsToMyVilla();
      allow delete: if isAdmin() && resourceBelongsToMyVilla();
    }

    // ─── Tickets de mantenimiento ─────────────────────────────────────────
    // Admin y staff pueden leer, crear y actualizar.
    // Solo admin puede borrar.
    match /maintenance_tickets/{ticketId} {
      allow read:   if (isAdmin() || isStaff()) && resourceBelongsToMyVilla();
      allow create: if (isAdmin() || isStaff()) && requestBelongsToMyVilla();
      allow update: if (isAdmin() || isStaff()) && resourceBelongsToMyVilla();
      allow delete: if isAdmin() && resourceBelongsToMyVilla();
    }

    // ─── Huéspedes ────────────────────────────────────────────────────────
    // Solo admin, misma restricción que bookings.
    match /guests/{guestId} {
      allow read:   if isAdmin() && resourceBelongsToMyVilla();
      allow create: if isAdmin() && requestBelongsToMyVilla();
      allow update: if isAdmin() && resourceBelongsToMyVilla() && requestBelongsToMyVilla();
      allow delete: if isAdmin() && resourceBelongsToMyVilla();
    }

    // ─── Perfiles de usuario ──────────────────────────────────────────────
    // Cada usuario puede leer SOLO su propio documento (para que la app
    // sepa su rol y villa). Escritura solo por admin.
    match /users/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }
  }
}
