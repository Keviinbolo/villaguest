rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDocExists() && userDoc().role == 'admin';
    }

    function isStaff() {
      return isSignedIn() && userDocExists() && userDoc().role == 'staff';
    }

    function isMember() {
      return isAdmin() || isStaff();
    }

    function myVilla() {
      return userDoc().villa;
    }

    // Existing document belongs to the user's villa
    function resourceIsMyVilla() {
      return isMember() && resource.data.villaId == myVilla();
    }

    // Incoming document will belong to the user's villa
    function requestIsMyVilla() {
      return isMember() && request.resource.data.villaId == myVilla();
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // • A user can always read their own document (needed by AuthProvider).
    // • A villa member can read other users in the same villa — required for
    //   the FCM notification token lookup (sendNotificationToVilla queries
    //   users by villa to collect device tokens).
    // • A user can update only their own document, and only fields that are
    //   NOT role or villa (prevents privilege escalation). This covers saving
    //   the FCM token (fcmToken, fcmUpdatedAt).
    // • No app-side create/delete — accounts are managed in Firebase Console.
    match /users/{uid} {
      allow read: if isSignedIn() &&
                     (request.auth.uid == uid ||
                      (userDocExists() && resource.data.villa == myVilla()));

      allow update: if isSignedIn() &&
                       request.auth.uid == uid &&
                       !request.resource.data.diff(resource.data)
                           .affectedKeys().hasAny(['role', 'villa']);
    }

    // ── bookings ──────────────────────────────────────────────────────────────
    // Admin-only. Scoped to their villa.
    match /bookings/{bookingId} {
      allow read, delete: if isAdmin() && resourceIsMyVilla();
      allow create:       if isAdmin() && requestIsMyVilla();
      allow update:       if isAdmin() && resourceIsMyVilla() && requestIsMyVilla();
    }

    // ── cleaning_checklists ───────────────────────────────────────────────────
    // Read + update: admin and staff (staff complete tasks in the field).
    // Create + delete: admin only (created from booking detail).
    match /cleaning_checklists/{checklistId} {
      allow read, update: if resourceIsMyVilla();
      allow create:       if isAdmin() && requestIsMyVilla();
      allow delete:       if isAdmin() && resourceIsMyVilla();
    }

    // ── maintenance_tickets ───────────────────────────────────────────────────
    // Read + create + update: admin and staff (staff reports issues in the field).
    // Delete: admin only.
    match /maintenance_tickets/{ticketId} {
      allow read, update: if resourceIsMyVilla();
      allow create:       if requestIsMyVilla();
      allow delete:       if isAdmin() && resourceIsMyVilla();
    }

    // ── guests ────────────────────────────────────────────────────────────────
    // Admin-only.
    match /guests/{guestId} {
      allow read, delete: if isAdmin() && resourceIsMyVilla();
      allow create:       if isAdmin() && requestIsMyVilla();
      allow update:       if isAdmin() && resourceIsMyVilla() && requestIsMyVilla();
    }

    // ── villa_settings ────────────────────────────────────────────────────────
    // The document ID is the villaId itself, so we compare directly.
    // Admin-only read and write.
    match /villa_settings/{villaId} {
      allow read, write: if isAdmin() && villaId == myVilla();
    }
  }
}
