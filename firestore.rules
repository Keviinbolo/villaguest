rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios autenticados (tú, el administrador) pueden leer o
    // escribir reservas. No hay registro público en esta app, así que
    // "autenticado" es equivalente a "eres tú".
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    match /cleaning_checklists/{checklistId} {
      allow read, write: if request.auth != null;
    }

    // A medida que agregues colecciones nuevas (guests, maintenance,
    // payments...), repite el mismo patrón aquí.
  }
}
