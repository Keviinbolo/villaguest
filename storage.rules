rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos del checklist de limpieza: solo el administrador autenticado
    // puede subir o leer. Sin esto, Firebase Storage en modo producción
    // bloquea TODO por defecto, así que uploadBytes() fallaría con un
    // error de permisos aunque hayas iniciado sesión en la app.
    match /cleaning_photos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
