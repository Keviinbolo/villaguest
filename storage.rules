rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function userDoc() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAdminOrStaff() {
      return request.auth != null &&
        userDoc().role in ['admin', 'staff'];
    }

    function isAdmin() {
      return request.auth != null &&
        userDoc().role == 'admin';
    }

    // Fotos de checklists de limpieza: admin y staff pueden subir y leer.
    match /cleaning_photos/{allPaths=**} {
      allow read, write: if isAdminOrStaff();
    }

    // Fotos de tickets de mantenimiento: admin y staff pueden subir y leer.
    match /maintenance_photos/{allPaths=**} {
      allow read, write: if isAdminOrStaff();
    }

    // Logo de la villa: solo el admin puede subir; admin y staff pueden leer.
    match /villa_logos/{allPaths=**} {
      allow read:  if isAdminOrStaff();
      allow write: if isAdmin();
    }
  }
}
